# HackFinder environment configuration
#
# Copy this file to .env.local and fill in real values there. Never commit
# .env.local or paste real secrets into this file — placeholders only.
#
# NEXT_PUBLIC_* variables are bundled into the browser and are NOT secret-safe.
# Every other variable is server-only and must never be exposed to the client.
#
# Run `npm run env:check` after editing to validate names/formats (it never
# prints secret values or contacts external services).

# =============================================================================
# Public (browser-safe) values
# =============================================================================
# REQUIRED for full mode (Supabase-backed Queue, Profile, Question Bank, Asset
# Bank, applications) | can stay unset for demo-only exploration.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# OPTIONAL — public fallback base URL. Also trusted (alongside APP_BASE_URL)
# for same-origin mutation checks. Prefer APP_BASE_URL for the private/
# Tailscale case; use this only if you intentionally want a public URL.
NEXT_PUBLIC_APP_URL=

# OPTIONAL — shown as the "Open Sheet" link when Google Sheets sync is set up.
NEXT_PUBLIC_GOOGLE_SHEET_URL=

# OPTIONAL — browser-side error reporting.
NEXT_PUBLIC_SENTRY_DSN=

# =============================================================================
# Core application / auth
# =============================================================================
# REQUIRED for web login (server-only). Plain password checked by the owner
# gate — this is a single-operator app, not multi-user auth.
APP_PASSWORD=change-me

# REQUIRED for web sessions (server-only). At least 32 random characters.
# Example: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SESSION_SECRET=

# OPTIONAL but recommended for local-first / phone access. The canonical
# private base URL HackFinder is served at — normally your Tailscale Serve
# HTTPS URL (e.g. https://your-machine.your-tailnet.ts.net). Used to build
# links in Discord notifications and trusted for same-origin mutation checks.
# Do NOT use Tailscale Funnel or a public hostname here.
APP_BASE_URL=

# OPTIONAL — legacy/informational fallback base URL, lowest priority behind
# APP_BASE_URL and NEXT_PUBLIC_APP_URL. Rarely needs to be set directly.
APP_URL=http://localhost:3000

# =============================================================================
# Demo / local fixtures (server-only flags)
# =============================================================================
# OPTIONAL — deterministic fixture Queue + forced dry-run persistence.
# Safe for a dedicated demo server. Does not silently enable itself.
DEMO_MODE=false
# OPTIONAL — development-only in-memory candidates. Forbidden in production
# unless DEMO_MODE=true or the preview escape hatch below.
USE_MOCK_CANDIDATES=false
# Preview-only escape hatch; never set on production deployments.
ALLOW_MOCK_CANDIDATES_IN_PREVIEW=false

# =============================================================================
# Supabase (server-only service role)
# =============================================================================
# REQUIRED for full mode: Queue persistence, applications, Profile, Question
# Bank, and Asset Bank file storage all read/write through this key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Asset Bank uploads (resume, transcripts, etc.) use a Supabase Storage bucket
# ("hackfinder-assets") created automatically on first upload — no separate
# storage env var is needed beyond the Supabase credentials above.

# =============================================================================
# AI / enrichment (server-only)
# =============================================================================
# OPTIONAL — deterministic parsing/drafting used when unset. Powers
# enrichment during discovery and AI-drafted answers for unresolved
# application questions.
# LLM_PROVIDER=openai|spur|mock
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_REQUEST_TIMEOUT_MS=20000
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=1500
LLM_MAX_CALLS_PER_RUN=12
LLM_MAX_CALLS_PER_CANDIDATE=3

# =============================================================================
# Search (server-only)
# =============================================================================
# OPTIONAL — web collector degrades when unset (mock needs no key).
# TinyFish is the preferred live provider, executed through Monid.
# Set SEARCH_PROVIDER=tinyfish and SEARCH_API_KEY to a Monid API key.
# SEARCH_PROVIDER=tinyfish|tavily|brave|exa|serpapi|mock
SEARCH_PROVIDER=
SEARCH_API_KEY=

# =============================================================================
# Discord remote control (server-only; optional)
# =============================================================================
# Discord reuses the same HackFinder services as the web app and terminal —
# it is not a separate bot engine. Required together for the gateway worker
# and `npm run hackfinder` to start it automatically.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
# The only Discord user allowed to run owner-authorized commands (blockers,
# drafts, Submit-now, etc.).
DISCORD_USER_ID=
# OPTIONAL — verifies interaction webhook signatures. If unset, it is fetched
# once from the Discord API using DISCORD_BOT_TOKEN.
DISCORD_PUBLIC_KEY=

# =============================================================================
# Google Sheets (server-only; optional integration)
# =============================================================================
# REQUIRED only when using approve -> Sheet sync.
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Hackathons
# Full service-account JSON as a single line. private_key may contain \n escapes.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Alias placeholders accepted by the schema but not currently read by any
# runtime code path; prefer the GOOGLE_SHEET_* / GOOGLE_SERVICE_ACCOUNT_JSON
# variables above.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_PRIVATE_KEY=
# GOOGLE_SPREADSHEET_ID=
# GOOGLE_SHEET_NAME=

# =============================================================================
# Discovery runtime
# =============================================================================
# local = in-process Next.js executor (dev/demo)
# worker = enqueue only; external worker claims jobs
DISCOVERY_EXECUTION_MODE=local
WORKER_SHARED_SECRET=
DISCOVERY_MAX_ACTIVE_JOBS=2
DISCOVERY_MAX_QUEUED_JOBS=10
DISCOVERY_PUBLIC_SOURCE_CONCURRENCY=3
DISCOVERY_SOURCE_LOCK_WAIT_MS=60000
DISCOVERY_JOB_TIMEOUT_MS=600000
DISCOVERY_EVENT_RETENTION_DAYS=14

# DEV-ONLY discovery job store override. memory is rejected in production
# unless DISCOVERY_ALLOW_MEMORY_STORE=true (emergency use only).
# DISCOVERY_JOB_STORE=memory|supabase
# DISCOVERY_ALLOW_MEMORY_STORE=false

# Per-source enable flags (optional; default true for mlh/web/hacklist/devpost/luma/hakku).
# Runtime toggles in Settings write .data/source-settings.json and override these.
# SOURCE_MLH_ENABLED=true
# SOURCE_WEB_ENABLED=true
# SOURCE_HACKLIST_ENABLED=true
# SOURCE_DEVPOST_ENABLED=true
# SOURCE_LUMA_ENABLED=true
# SOURCE_HAKKU_ENABLED=true

# =============================================================================
# Source browser / Hakku (owner machine / private worker only)
# =============================================================================
BROWSER_PROFILE_ROOT=.data/browser-profiles
HAKKU_PROFILE_NAME=hakku
HAKKU_BROWSER_HEADLESS=true
# DEV/TEST-ONLY override to force Hakku "connected" status without a real
# browser profile. Never set this in production.
# HAKKU_CONNECTED=false

# Terminal multi-session store: memory (DEV-ONLY) | supabase (requires migration 007)
# TERMINAL_SESSION_STORE=memory
# TERMINAL_ALLOW_MEMORY_STORE=false

# =============================================================================
# Local HackFinder runtime (`npm run hackfinder` supervisor)
# =============================================================================
# OPTIONAL — web app port used by the local supervisor's health checks.
PORT=3000
# OPTIONAL — how often the discovery worker runs a scheduled pass (ms).
HACKFINDER_DISCOVERY_INTERVAL_MS=21600000
# OPTIONAL — how often the application tracker runs a pass (ms).
HACKFINDER_TRACKER_INTERVAL_MS=3600000

# =============================================================================
# Persistence (emergency / debug only — not recommended)
# =============================================================================
# Discovery persistence is batch-only in normal operation. Any other value,
# including the obsolete "v1", resolves to batch with a warning.
# PERSISTENCE_STRATEGY=batch
# Emergency rollback only (dev/test). Never set in production.
# PERSISTENCE_ROLLBACK_V1=false
# PERSISTENCE_BATCH_VERIFY_AFTER_WRITE=false
# PERSISTENCE_BATCH_SHADOW=false

# =============================================================================
# X / Twitter MCP (optional; never required)
# =============================================================================
X_MCP_MODE=app-only
X_MCP_URL=https://api.x.com/mcp
X_BEARER_TOKEN=
X_MAX_QUERIES_PER_RUN=6
X_MAX_POSTS_PER_QUERY=20
X_TOTAL_POST_LIMIT=60
X_REQUEST_TIMEOUT_MS=15000

# =============================================================================
# Optional observability
# =============================================================================
SENTRY_DSN=

# =============================================================================
# QA / smoke / test-only (never required for app boot)
# =============================================================================
# Base URL used by smoke and design-capture scripts against a running server.
# SMOKE_BASE_URL=http://localhost:3000
# Identifies this process when DISCOVERY_EXECUTION_MODE=worker; auto-generated
# if unset.
# WORKER_ID=
# Fixture/verification scripts only (seed-application-fixture, verify-drafts-
# browser, verify-real-form-fixture, private-route-acceptance, test-discord).
# APPLICATION_FIXTURE_ID=
# APPLICATION_FIXTURE_KIND=gateway|browser|gateway_acceptance|resume
# VERIFY_DRAFT_MODE=delete
# CONTROLLED_FORM_URL=http://127.0.0.1:3000/fixtures/controlled-application
# DISCORD_TEST_APPLICATION_ID=
# PRIVATE_ROUTE_NAMES=
# Non-production override to mock the Hakku source connection in tests.
# TERMINAL_SOURCE_MOCK_HAKKU=false
# Opt-in gate for the live Google Sheets integration test suite.
# RUN_GOOGLE_SHEETS_INTEGRATION=false
